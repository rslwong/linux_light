 	options->speed = xf86libinput_parse_accel_option(pInfo, device);
 	options->accel_profile = xf86libinput_parse_accel_profile_option(pInfo, device);
 #if HAVE_LIBINPUT_CUSTOM_ACCEL
@@ -4222,6 +4292,8 @@
 static Atom prop_tap_drag_default;
 static Atom prop_tap_drag_lock;
 static Atom prop_tap_drag_lock_default;
+static Atom prop_3fg_drag;
+static Atom prop_3fg_drag_default;
 static Atom prop_tap_buttonmap;
 static Atom prop_tap_buttonmap_default;
 static Atom prop_calibration;
@@ -4497,6 +4569,37 @@
 }
 
 static inline int
+LibinputSetProperty3fgDrag(DeviceIntPtr dev,
+			   Atom atom,
+			   XIPropertyValuePtr val,
+			   BOOL checkonly)
+{
+	InputInfoPtr pInfo = dev->public.devicePrivate;
+	struct xf86libinput *driver_data = pInfo->private;
+	struct libinput_device *device = driver_data->shared_device->device;
+	CARD8 fingers;
+
+	if (val->format != 8 || val->size != 1 || val->type != XA_INTEGER)
+		return BadMatch;
+
+	fingers = *(CARD8*)val->data;
+	if (checkonly) {
+		if (fingers != 0 && fingers != 3 && fingers != 4)
+			return BadValue;
+
+		if (!xf86libinput_check_device(dev, atom))
+			return BadMatch;
+
+		if (libinput_device_config_3fg_drag_get_finger_count(device) < fingers)
+			return BadValue;
+	} else {
+		driver_data->options.drag_3fg = fingers_to_drag_3fg(fingers);
+	}
+
+	return Success;
+}
+
+static inline int
 LibinputSetPropertyTapButtonmap(DeviceIntPtr dev,
 				Atom atom,
 				XIPropertyValuePtr val,
@@ -5455,6 +5558,8 @@
 		rc = LibinputSetPropertyTapDrag(dev, atom, val, checkonly);
 	else if (atom == prop_tap_drag_lock)
 		rc = LibinputSetPropertyTapDragLock(dev, atom, val, checkonly);
+	else if (atom == prop_3fg_drag)
+		rc = LibinputSetProperty3fgDrag(dev, atom, val, checkonly);
 	else if (atom == prop_tap_buttonmap)
 		rc = LibinputSetPropertyTapButtonmap(dev, atom, val, checkonly);
 	else if (atom == prop_calibration)
@@ -5548,6 +5653,7 @@
 		 atom == prop_tap_default ||
 		 atom == prop_tap_drag_default ||
 		 atom == prop_tap_drag_lock_default ||
+		 atom == prop_3fg_drag_default ||
 		 atom == prop_tool_id ||
 		 atom == prop_device)
 		return BadAccess; /* read-only */
@@ -5666,6 +5772,33 @@
 }
 
 static void
+LibinputInit3fgDragProperty(DeviceIntPtr dev,
+			    struct xf86libinput *driver_data,
+			    struct libinput_device *device)
+{
+	CARD8 fingers = drag_3fg_to_fingers(driver_data->options.drag_3fg);
+
+	if (!subdevice_has_capabilities(dev, CAP_POINTER))
+		return;
+
+	if (libinput_device_config_3fg_drag_get_finger_count(device) < 3)
+		return;
+
+	prop_3fg_drag = LibinputMakeProperty(dev,
+					     LIBINPUT_PROP_3FG_DRAG,
+					     XA_INTEGER, 8,
+					     1, &fingers);
+	if (!prop_3fg_drag)
+		return;
+
+	fingers = drag_3fg_to_fingers(libinput_device_config_3fg_drag_get_default_enabled(device));
+	prop_3fg_drag_default = LibinputMakeProperty(dev,
+						     LIBINPUT_PROP_3FG_DRAG_DEFAULT,
+						     XA_INTEGER, 8,
+						     1, &fingers);
+}
+
+static void
 LibinputInitTapButtonmapProperty(DeviceIntPtr dev,
 				 struct xf86libinput *driver_data,
 				 struct libinput_device *device)
@@ -6695,6 +6828,7 @@
 	LibinputInitTapDragProperty(dev, driver_data, device);
 	LibinputInitTapDragLockProperty(dev, driver_data, device);
 	LibinputInitTapButtonmapProperty(dev, driver_data, device);
+	LibinputInit3fgDragProperty(dev, driver_data, device);
 	LibinputInitNaturalScrollProperty(dev, driver_data, device);
 	LibinputInitDisableWhileTypingProperty(dev, driver_data, device);
 	LibinputInitScrollMethodsProperty(dev, driver_data, device);
